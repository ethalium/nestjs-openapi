{
  "name": "@ethalium/nestjs-openapi",
  "version": "0.1.1",
  "description": "Wrapper around @nestjs/swagger to generate OpenAPI spec from decorators.",
  "author": {
    "name": "Ethalium",
    "url": "https://github.com/ethalium"
  },
  "repository": "https://github.com/ethalium/nestjs-openapi",
  "private": false,
  "license": "MIT",
  "scripts": {
    "lib:index": "barrelsby --config barrelsby.config.json",
    "lib:build": "npm run lib:index && nest build lib",
    "lib:format": "prettier --write \"lib/**/*.ts\" \"test/**/*.ts\"",
    "lib:lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lib:test": "jest --watchAll",
    "lib:publish": "npm run lib:build && cd dist/lib && npm publish --access public",
    "lib:pack": "npm run lib:build && cd dist/lib && npm pack",
    "example:start": "npm run lib:index && nest start example-app --watch"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/swagger": "11.4.2",
    "lodash": ">=4.17.23",
    "reflect-metadata": ">=0.2.2",
    "rxjs": ">=7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": ">=11.0.23",
    "@nestjs/platform-express": ">=11.1.27",
    "@nestjs/schematics": ">=11.1.0",
    "@nestjs/testing": ">=11.1.27",
    "@scalar/nestjs-api-reference": "^1.2.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.2.0",
    "barrelsby": "^2.8.1",
    "class-transformer": "^0.5.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "test",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
